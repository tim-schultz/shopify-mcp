{
  "name": "shopify-product-search",
  "version": "0.1.0",
  "private": true,
  "description": "Discover Shopify sellers and search verified storefront MCP catalogs from an agent-friendly CLI.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/tim-schultz/shopify-mcp.git" },
  "homepage": "https://github.com/tim-schultz/shopify-mcp#readme",
  "bugs": { "url": "https://github.com/tim-schultz/shopify-mcp/issues" },
  "engines": { "node": ">=22" },
  "bin": { "shop-search": "./dist/bin.js" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./cli": { "types": "./dist/cli.d.ts", "import": "./dist/cli.js" }
  },
  "files": ["dist", "SKILL.md", "references"],
  "scripts": {
    "dev": "tsx src/bin.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "release:pack": "node scripts/release.mjs",
    "prepack": "npm run check && npm test && npm run build"
  },
  "dependencies": { "incur": "0.7.1" },
  "bundleDependencies": ["incur"],
  "devDependencies": { "@types/node": "^22.0.0", "tsx": "^4.0.0", "typescript": "^5.9.0" },
  "keywords": ["shopify", "mcp", "ucp", "incur", "agent-skills", "shopping", "cli"]
}
